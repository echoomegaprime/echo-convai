{
  "name": "@echo-prime/convai-react",
  "version": "1.0.0",
  "description": "React SDK for Echo ConvAI — conversational AI components and hooks",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "echo",
    "convai",
    "conversational-ai",
    "react",
    "voice",
    "websocket",
    "real-time"
  ],
  "author": "Echo Prime Technologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobmcwilliams4/echo-convai"
  }
}
