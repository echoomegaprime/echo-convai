{
  "name": "echo-convai-api",
  "version": "1.0.0",
  "description": "ElevenLabs-compatible ConvAI REST API on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute echo-convai-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute echo-convai-db --local --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
